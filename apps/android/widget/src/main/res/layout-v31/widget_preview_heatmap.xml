<?xml version="1.0" encoding="utf-8"?>
<!-- W3's static preview (previewLayout, Android 12–14): HeatmapWidgetContent's header over a
     drawn sample grid, with PreviewHabits' "Drink water". Android 15+ shows the generated
     preview instead. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_preview_background"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:gravity="center_vertical"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_habit_water"
            android:tint="@color/widget_preview_blue" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="6dp"
            android:layout_weight="1"
            android:maxLines="1"
            android:text="@string/android_widget_preview_water"
            android:textColor="@color/widget_preview_on_surface"
            android:textFontWeight="500"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="5 / 8"
            android:textColor="@color/widget_preview_on_surface_variant"
            android:textSize="12sp"
            tools:ignore="HardcodedText" />
    </LinearLayout>

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:importantForAccessibility="no"
        android:scaleType="fitStart"
        android:src="@drawable/widget_preview_heatmap" />
</LinearLayout>
