<?xml version="1.0" encoding="utf-8"?>
<!-- The static widget previews (previewLayout, Android 12–14). The theme colors are Glance's
     dynamic ones (DynamicThemeColorProviders), so a preview matches the widget it adds. The habit
     colors are the sample habits' presets (PreviewHabits.kt): GradientPresets' last stops. -->
<resources>
    <color name="widget_preview_background">@android:color/system_accent2_50</color>
    <color name="widget_preview_on_surface">@android:color/system_neutral1_900</color>
    <color name="widget_preview_on_surface_variant">@android:color/system_neutral2_700</color>
    <color name="widget_preview_surface_variant">@android:color/system_neutral2_100</color>
    <color name="widget_preview_secondary_container">@android:color/system_accent2_100</color>
    <color name="widget_preview_on_secondary_container">@android:color/system_accent2_900</color>
    <color name="widget_preview_blue">#FF1D4ED8</color>
    <color name="widget_preview_purple">#FF7E22CE</color>
    <color name="widget_preview_green">#FF15803D</color>
</resources>
