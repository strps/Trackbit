<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <receiver
            android:name=".today.TodayWidgetReceiver"
            android:exported="false"
            android:label="@string/android_widget_today_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/today_widget_info" />
        </receiver>

        <receiver
            android:name=".quicklog.QuickLogWidgetReceiver"
            android:exported="false"
            android:label="@string/android_widget_quick_log_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/quick_log_widget_info" />
        </receiver>

        <receiver
            android:name=".heatmap.HeatmapWidgetReceiver"
            android:exported="false"
            android:label="@string/android_widget_heatmap_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/heatmap_widget_info" />
        </receiver>

        <!-- Exported for the launcher. Its own task, so it never lands on top of the app's. -->
        <activity
            android:name=".habit.HabitPickerActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Material.Light.NoActionBar">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- The midnight alarm, plus clock and timezone changes, which can change the day too. -->
        <receiver
            android:name=".DayRolloverReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- Republishes the generated widget previews (Android 15+) after an update or a locale change. -->
        <receiver
            android:name=".preview.WidgetPreviewReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.LOCALE_CHANGED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
