<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing is backed up or transferred: the session's Keystore key never moves to another
     device, and everything else local is a server cache. `allowBackup="false"` covers older
     versions; on Android 12+ it no longer covers device-to-device transfer, these rules do. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
